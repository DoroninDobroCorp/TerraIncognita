# Terra Incognita backend configuration. Copy to .env and edit.
# Every setting is also available as an environment variable with the TERRA_ prefix.
# Core discovery (OpenStreetMap, Wikidata, Atlas Obscura) works without any keys.

# ── LLM (optional: chat, descriptions, stories, recommendations) ──
# TERRA_LLM_PROVIDER=anthropic          # anthropic | openai
# TERRA_ANTHROPIC_API_KEY=sk-ant-...
# TERRA_LLM_MODEL=claude-sonnet-5-5     # cheaper: claude-haiku-5-5
# TERRA_OPENAI_API_KEY=sk-...           # needs: pip install ".[openai]"
# TERRA_OPENAI_MODEL=gpt-4.1-mini
# TERRA_LLM_DAILY_TOKEN_CAP=500000      # input+output tokens per UTC day; 0 = unlimited
# TERRA_LLM_CACHE_TTL_SECONDS=0         # generated descriptions: 0 = keep forever

# ── Deep research enrichment (optional) ──
# TERRA_GEMINI_API_KEY=
# TERRA_DEEP_RESEARCH_ENABLED=true

# ── Data sources ──
# TERRA_OVERPASS_URL=https://overpass-api.de/api/interpreter
# TERRA_CACHE_DIR=cache
# TERRA_CACHE_TTL_SECONDS=86400

# ── Search defaults ──
# TERRA_DEFAULT_RADIUS_KM=5.0
# TERRA_MAX_RADIUS_KM=50.0

# ── Storage (point these at a persistent volume in production) ──
# TERRA_JOURNAL_DATA_DIR=data/journal
# TERRA_GAMIFICATION_DATA_DIR=data/gamification
# TERRA_COMMUNITY_DATA_DIR=data/community
# TERRA_OFFLINE_DATA_DIR=data/offline

# ── HTTP / security ──
# Allowed browser origins, comma-separated. "*" = any (fine for local use).
# TERRA_CORS_ORIGINS=https://terra.example.com
# Number of reverse proxies in front of the app (nginx = 1). Required for per-user
# rate limits to work behind a proxy; leave 0 when exposed directly.
# TERRA_TRUSTED_PROXY_HOPS=1
# TERRA_RATE_LIMIT_ENABLED=true
# TERRA_BLOCK_SCANNER_PATHS=true
# TERRA_SECURITY_HEADERS_ENABLED=true
# TERRA_CSP=default                     # "" disables, anything else is used verbatim

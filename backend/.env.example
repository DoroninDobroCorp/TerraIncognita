# Terra Incognita backend configuration. Copy to .env and edit.
# Every setting is also available as an environment variable with the TERRA_ prefix.
# Core discovery (OpenStreetMap, Wikidata, Atlas Obscura) works without any keys.
#
# Keep comments on their own lines: systemd's EnvironmentFile= and `docker run --env-file`
# do NOT strip a trailing "# comment", it would become part of the value.

# ── LLM (optional: chat, descriptions, stories, recommendations) ──
# Provider: anthropic or openai
# TERRA_LLM_PROVIDER=anthropic
# TERRA_ANTHROPIC_API_KEY=sk-ant-...
# Claude model; claude-haiku-5-5 is the cheapest option
# TERRA_LLM_MODEL=claude-sonnet-5-5
# Thinking depth for Claude: low, medium, high, xhigh or max. Leave empty for models without effort support.
# TERRA_LLM_EFFORT=low
# OpenAI needs: pip install ".[openai]"
# TERRA_OPENAI_API_KEY=sk-...
# Chat models of the gpt-4.1 class work; reasoning models reject max_tokens and temperature (not supported)
# TERRA_OPENAI_MODEL=gpt-4.1-mini
# Daily cap on input+output tokens (UTC day) for calls made through the LLM client (0 = unlimited).
# New calls stop once it is reached; calls already in flight finish and are counted.
# Deep Research (Gemini/Parallel) is billed separately and is not counted.
# TERRA_LLM_DAILY_TOKEN_CAP=500000
# Lifetime of generated descriptions in seconds (0 = keep forever)
# TERRA_LLM_CACHE_TTL_SECONDS=0

# ── Deep research enrichment (optional) ──
# TERRA_PARALLEL_API_KEY=
# TERRA_GEMINI_API_KEY=
# TERRA_DEEP_RESEARCH_ENABLED=true

# ── Data sources ──
# Read Atlas Obscura's public pages for an extra signal (set false to never contact the site)
# TERRA_ATLAS_OBSCURA_ENABLED=true
# Identify yourself to Wikipedia/Wikidata/Commons (their policy): app name plus a contact URL or e-mail
# TERRA_WIKIMEDIA_USER_AGENT=TerraIncognita/0.2 (https://example.com/contact)
# TERRA_OVERPASS_URL=https://overpass-api.de/api/interpreter
# TERRA_CACHE_DIR=cache
# TERRA_CACHE_TTL_SECONDS=86400
# Answer /api/discover after this many seconds if any source has produced places
# TERRA_DISCOVERY_DEADLINE_SECONDS=25

# ── Search defaults ──
# TERRA_DEFAULT_RADIUS_KM=5.0
# TERRA_MAX_RADIUS_KM=50.0

# ── Storage (point these at a persistent volume in production) ──
# TERRA_JOURNAL_DATA_DIR=data/journal
# TERRA_GAMIFICATION_DATA_DIR=data/gamification
# TERRA_COMMUNITY_DATA_DIR=data/community
# TERRA_OFFLINE_DATA_DIR=data/offline

# ── HTTP / security ──
# Allowed browser origins, comma-separated. "*" = any (fine for local use).
# TERRA_CORS_ORIGINS=https://terra.example.com
# Number of reverse proxies in front of the app (nginx = 1). Required for per-user
# rate limits to work behind a proxy; leave 0 when exposed directly.
# TERRA_TRUSTED_PROXY_HOPS=1
# TERRA_RATE_LIMIT_ENABLED=true
# TERRA_BLOCK_SCANNER_PATHS=true
# TERRA_SECURITY_HEADERS_ENABLED=true
# Content-Security-Policy: "default" = built-in policy, empty = disabled, anything else is sent verbatim
# TERRA_CSP=default

# /etc/systemd/system/terra-incognita.service
# Logs go to journald: `journalctl -u terra-incognita -f` (no server.log to grow forever).
#
# One-time setup (ReadWritePaths= fails the unit when a path does not exist yet):
#   useradd --system terra
#   install -d -o terra -g terra -m 0750 /srv/terra/backend/data /srv/terra/backend/cache
#   install -m 0640 -o root -g terra backend/.env.example /srv/terra/backend/.env   # optional (the "-" below)
#   (systemd reads it as root, the app itself reads the same file as user `terra`: group-readable, never world-readable,
#    because it will hold API keys)
[Unit]
Description=Terra Incognita API
After=network.target

[Service]
User=terra
WorkingDirectory=/srv/terra/backend
EnvironmentFile=-/srv/terra/backend/.env
ExecStart=/srv/terra/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/terra/backend/data /srv/terra/backend/cache

[Install]
WantedBy=multi-user.target
